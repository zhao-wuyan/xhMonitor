  "cards": [
    {
      "dot": "cyan",
      "title": "进程编排 (ApplicationHostedService)",
      "items": [
        "xhm-service 探活 :35179 通过后才启动 Web 服务层",
        "发布态运行 xhm-service.exe，开发态回退 cargo run",
        "停止时并行 Kill 进程树；PowerControlService 经 REST 切档"
      ]
    },
    {
      "dot": "emerald",
      "title": "实时链路 (SignalR 兼容)",
      "items": [
        "Rust 手写 SignalR JSON 协议，事件名与旧 C# 逐字节兼容",
        "事件：ReceiveSystemUsage / ReceiveProcessMetrics(Lite)",
        "双消费者：WPF 悬浮窗与 React 前端；SSE 为备选通道"
      ]
    },
    {
      "dot": "amber",
      "title": "数据生命周期 (SQLite)",
      "items": [
        "原始指标以 MetricsJson 写入，record_metrics 可按需关闭",
        "5min 任务做 Minute→Hour→Day 聚合，覆盖校验后才删源层",
        "默认保留 30 天，断点存 MetricLifecycleCheckpoints"
      ]
    }
  ]
