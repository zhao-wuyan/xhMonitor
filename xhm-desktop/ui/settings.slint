component Field inherits Rectangle {
    in property <string> label;
    in-out property <string> value;
    in property <InputType> input-type: text;
    in property <bool> editable: true;
    callback changed(string);
    width: 300px;
    height: 42px;
    background: transparent;
    opacity: root.editable ? 1 : 0.42;

    Text {
        x: 0px;
        y: 0px;
        width: parent.width;
        text: root.label;
        color: #ffffffa8;
        font-size: 10px;
        font-weight: 600;
    }
    Rectangle {
        y: 16px;
        width: parent.width;
        height: 26px;
        background: root.editable ? #ffffff0d : #ffffff08;
        border-color: root.editable ? #ffffff24 : #ffffff14;
        border-width: 1px;
        border-radius: 4px;
        TextInput {
            x: 8px;
            y: 4px;
            width: parent.width - 16px;
            height: 18px;
            text: root.value;
            input-type: root.input-type;
            enabled: root.editable;
            color: #ffffffe6;
            font-size: 10px;
            edited => {
                if root.editable {
                    root.changed(self.text);
                }
            }
        }
    }
}

component Switch inherits Rectangle {
    in property <string> label;
    in-out property <bool> checked;
    callback toggled(bool);
    width: 194px;
    height: 28px;
    background: transparent;

    Text {
        x: 0px;
        y: 6px;
        width: 150px;
        text: root.label;
        color: #ffffffc4;
        font-size: 10px;
        overflow: elide;
    }
    Rectangle {
        x: 158px;
        y: 5px;
        width: 30px;
        height: 17px;
        background: root.checked ? #38bdf8b3 : #ffffff26;
        border-radius: 9px;
        Rectangle {
            x: root.checked ? 15px : 2px;
            y: 2px;
            width: 13px;
            height: 13px;
            background: #fffffff2;
            border-radius: 7px;
            animate x { duration: 100ms; }
        }
        TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.checked = !root.checked;
                root.toggled(root.checked);
            }
        }
    }
}

component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    callback clicked;
    width: 92px;
    height: 32px;
    background: root.primary ? #0ea5e9d9 : button-touch.has-hover ? #ffffff22 : #ffffff12;
    border-color: root.primary ? #38bdf8 : #ffffff24;
    border-width: 1px;
    border-radius: 4px;
    Text {
        text: root.text;
        color: #fffffff2;
        font-size: 10px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    button-touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component SectionTitle inherits Text {
    in property <string> title;
    text: root.title;
    color: #38bdf8;
    font-size: 10px;
    font-weight: 700;
}

export component SettingsWindow inherits Window {
    title: "xhMonitor 设置";
    width: 680px;
    height: 900px;
    background: #101217;

    in-out property <string> status-text: "正在加载设置…";
    in-out property <string> opacity-text: "90";
    in-out property <string> process-keywords: "[]";
    in-out property <string> top-process-count: "10";
    in-out property <string> data-retention-days: "30";
    in-out property <bool> monitor-cpu: true;
    in-out property <bool> monitor-memory: true;
    in-out property <bool> monitor-gpu: true;
    in-out property <bool> monitor-vram: true;
    in-out property <bool> monitor-power: true;
    in-out property <bool> monitor-network: true;
    in-out property <bool> enable-floating-mode: true;
    in-out property <bool> enable-edge-dock-mode: false;
    in-out property <bool> bar-visual: true;
    in-out property <string> dock-column-gap: "0";
    in-out property <string> dock-cpu-label: "CPU";
    in-out property <string> dock-memory-label: "RAM";
    in-out property <string> dock-gpu-label: "GPU";
    in-out property <string> dock-vram-label: "VRAM";
    in-out property <string> dock-power-label: "PWR";
    in-out property <string> dock-upload-label: "UP";
    in-out property <string> dock-download-label: "DN";
    in-out property <bool> admin-mode: false;
    in-out property <bool> start-with-windows: false;
    in-out property <bool> enable-lan-access: false;
    in-out property <bool> enable-access-key: false;
    in-out property <string> access-key: "";
    in-out property <string> ip-whitelist: "";
    in-out property <string> local-ip: "正在获取…";
    callback load-settings();
    callback save-settings();
    callback close-window();

    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 58px;
        background: #151922;
        Rectangle { x: 18px; y: 15px; width: 3px; height: 28px; background: #38bdf8; border-radius: 2px; }
        Text { x: 30px; y: 11px; text: "设置"; color: #fffffff2; font-size: 16px; font-weight: 700; }
        Text { x: 30px; y: 34px; width: 620px; text: root.status-text; color: #ffffff8f; font-size: 9px; overflow: elide; }
    }

    Rectangle {
        x: 18px; y: 72px; width: 644px; height: 116px;
        background: #ffffff08; border-color: #ffffff18; border-width: 1px; border-radius: 5px;
        SectionTitle { x: 14px; y: 10px; title: "外观"; }
        Field {
            x: 14px; y: 32px; width: 202px; label: "悬浮窗透明度（20–100）"; input-type: number;
            value: root.opacity-text; changed(value) => { root.opacity-text = value; }
        }
        Switch { x: 238px; y: 35px; label: "悬浮窗模式"; checked: root.enable-floating-mode; toggled(value) => { root.enable-floating-mode = value; } }
        Switch { x: 438px; y: 35px; label: "迷你／贴边模式"; checked: root.enable-edge-dock-mode; toggled(value) => { root.enable-edge-dock-mode = value; } }
        Text { x: 238px; y: 83px; text: "迷你／贴边风格"; color: #ffffffa8; font-size: 10px; font-weight: 600; }
        Rectangle {
            x: 354px; y: 77px; width: 156px; height: 27px; background: #ffffff0d;
            border-color: #ffffff20; border-width: 1px; border-radius: 4px;
            Rectangle { x: root.bar-visual ? 78px : 0px; width: 78px; height: parent.height; background: #38bdf826; border-radius: 4px; }
            Text { x: 0px; y: 5px; width: 78px; text: "文本"; color: !root.bar-visual ? #38bdf8 : #ffffff80; font-size: 10px; horizontal-alignment: center; }
            Text { x: 78px; y: 5px; width: 78px; text: "柱状条"; color: root.bar-visual ? #38bdf8 : #ffffff80; font-size: 10px; horizontal-alignment: center; }
            TouchArea { mouse-cursor: pointer; clicked => { root.bar-visual = !root.bar-visual; } }
        }
    }

    Rectangle {
        x: 18px; y: 200px; width: 644px; height: 92px;
        background: #ffffff08; border-color: #ffffff18; border-width: 1px; border-radius: 5px;
        SectionTitle { x: 14px; y: 10px; title: "监控项"; }
        Switch { x: 14px; y: 31px; label: "CPU"; checked: root.monitor-cpu; toggled(value) => { root.monitor-cpu = value; } }
        Switch { x: 224px; y: 31px; label: "内存"; checked: root.monitor-memory; toggled(value) => { root.monitor-memory = value; } }
        Switch { x: 434px; y: 31px; label: "显卡 GPU"; checked: root.monitor-gpu; toggled(value) => { root.monitor-gpu = value; } }
        Switch { x: 14px; y: 59px; label: "显存 VRAM"; checked: root.monitor-vram; toggled(value) => { root.monitor-vram = value; } }
        Switch { x: 224px; y: 59px; label: "功耗"; checked: root.monitor-power; toggled(value) => { root.monitor-power = value; } }
        Switch { x: 434px; y: 59px; label: "网络"; checked: root.monitor-network; toggled(value) => { root.monitor-network = value; } }
    }

    Rectangle {
        x: 18px; y: 304px; width: 644px; height: 116px;
        background: #ffffff08; border-color: #ffffff18; border-width: 1px; border-radius: 5px;
        SectionTitle { x: 14px; y: 10px; title: "数据采集"; }
        Field {
            x: 14px; y: 32px; width: 300px; label: "进程监控关键词";
            value: root.process-keywords; changed(value) => { root.process-keywords = value; }
        }
        Field {
            x: 330px; y: 32px; width: 140px; label: "Top 进程数量"; input-type: number;
            value: root.top-process-count; changed(value) => { root.top-process-count = value; }
        }
        Field {
            x: 486px; y: 32px; width: 144px; label: "历史数据保留时长（天）"; input-type: number;
            value: root.data-retention-days; changed(value) => { root.data-retention-days = value; }
        }
        Text { x: 14px; y: 82px; width: 610px; text: "每行一个关键词，支持正则，! 前缀表示排除"; color: #ffffff70; font-size: 9px; }
    }

    Rectangle {
        x: 18px; y: 432px; width: 644px; height: 220px;
        background: #ffffff08; border-color: #ffffff18; border-width: 1px; border-radius: 5px;
        SectionTitle { x: 14px; y: 10px; title: "迷你／贴边指标名称"; }
        Field { x: 14px; y: 32px; label: "CPU 名称"; value: root.dock-cpu-label; changed(value) => { root.dock-cpu-label = value; } }
        Field { x: 330px; y: 32px; label: "内存名称"; value: root.dock-memory-label; changed(value) => { root.dock-memory-label = value; } }
        Field { x: 14px; y: 78px; label: "GPU 名称"; value: root.dock-gpu-label; changed(value) => { root.dock-gpu-label = value; } }
        Field { x: 330px; y: 78px; label: "VRAM 名称"; value: root.dock-vram-label; changed(value) => { root.dock-vram-label = value; } }
        Field { x: 14px; y: 124px; label: "功耗名称"; value: root.dock-power-label; changed(value) => { root.dock-power-label = value; } }
        Field { x: 330px; y: 124px; label: "上传前缀"; value: root.dock-upload-label; changed(value) => { root.dock-upload-label = value; } }
        Field { x: 14px; y: 170px; label: "下载前缀"; value: root.dock-download-label; changed(value) => { root.dock-download-label = value; } }
        Field { x: 330px; y: 170px; label: "组间距（px，0–24）"; input-type: number; value: root.dock-column-gap; changed(value) => { root.dock-column-gap = value; } }
    }

    Rectangle {
        x: 18px; y: 664px; width: 644px; height: 174px;
        background: #ffffff08; border-color: #ffffff18; border-width: 1px; border-radius: 5px;
        SectionTitle { x: 14px; y: 10px; title: "系统"; }
        Switch { x: 14px; y: 31px; label: "开机自启动"; checked: root.start-with-windows; toggled(value) => { root.start-with-windows = value; } }
        Switch { x: 224px; y: 31px; label: "管理员模式"; checked: root.admin-mode; toggled(value) => { root.admin-mode = value; } }
        Switch { x: 434px; y: 31px; label: "启用局域网访问"; checked: root.enable-lan-access; toggled(value) => { root.enable-lan-access = value; } }
        Switch { x: 14px; y: 61px; label: "要求访问密钥"; checked: root.enable-access-key; toggled(value) => { root.enable-access-key = value; } }
        Field {
            x: 14px; y: 91px; label: "访问密钥"; input-type: password; editable: root.enable-access-key;
            value: root.access-key; changed(value) => { root.access-key = value; }
        }
        Field {
            x: 330px; y: 91px; label: "IP 白名单";
            value: root.ip-whitelist; changed(value) => { root.ip-whitelist = value; }
        }
        Text { x: 14px; y: 137px; width: 300px; text: "留空将自动生成"; color: root.enable-access-key ? #ffffff70 : #ffffff42; font-size: 9px; }
        Text { x: 330px; y: 137px; width: 300px; text: "每行一个 IP 或 CIDR"; color: #ffffff70; font-size: 9px; }
        Text { x: 14px; y: 155px; width: 616px; text: "本机 IP 显示：" + root.local-ip; color: #81c784; font-size: 9px; overflow: elide; }
    }

    ActionButton { x: 362px; y: 852px; text: "重新加载"; clicked => { root.load-settings(); } }
    ActionButton { x: 462px; y: 852px; text: "关闭"; clicked => { root.close-window(); } }
    ActionButton { x: 562px; y: 852px; text: "保存"; primary: true; clicked => { root.save-settings(); } }
}
