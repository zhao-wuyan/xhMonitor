import { ListView } from "std-widgets.slint";
import { OrganicShell } from "components/organic_shell.slint";

export struct MetricData {
    id: string,
    label: string,
    value: string,
    detail: string,
    ratio: float,
    accent: color,
}

export struct ProcessData {
    pid: int,
    name: string,
    cpu-text: string,
    cpu-ratio: float,
    cpu-color: color,
    memory-text: string,
    memory-ratio: float,
    memory-color: color,
    gpu-text: string,
    gpu-ratio: float,
    gpu-color: color,
    vram-text: string,
    vram-ratio: float,
    vram-color: color,
    pinned: bool,
}

export struct DiskData {
    name: string,
    read-text: string,
    write-text: string,
}

component ThinProgressBar inherits Rectangle {
    in property <float> ratio;
    in property <color> accent: #4ade80;
    height: 3px;
    background: #ffffff1a;
    border-radius: 1.5px;

    Rectangle {
        width: parent.width * max(0.0, min(1.0, root.ratio));
        height: 3px;
        background: root.accent;
        border-radius: 1.5px;
        animate width { duration: 160ms; easing: ease-out; }
    }
}

component MetricCell inherits Rectangle {
    in property <MetricData> metric;
    in property <float> interaction-scale: 1.0;
    width: 88px;
    height: 54px;
    background: transparent;

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: parent.width * root.interaction-scale;
        height: parent.height * root.interaction-scale;
        background: transparent;

        Text {
            x: 6px;
            y: 6px;
            text: root.metric.label;
            color: #ffffff8f;
            font-size: 10px;
            font-weight: 600;
        }
        Text {
            x: 6px;
            y: 5px;
            width: parent.width - 12px;
            text: root.metric.value;
            color: root.metric.accent;
            font-size: 13px;
            font-weight: 700;
            horizontal-alignment: right;
        }
        ThinProgressBar {
            x: 6px;
            y: 31px;
            width: parent.width - 12px;
            ratio: root.metric.ratio;
            accent: root.metric.accent;
        }
        Text {
            x: 6px;
            y: 38px;
            width: parent.width - 12px;
            text: root.metric.detail;
            color: #ffffff70;
            font-size: 9px;
            horizontal-alignment: right;
            overflow: elide;
        }
    }
}

component PinnedCard inherits Rectangle {
    in property <ProcessData> process;
    callback unpin(int);
    width: 596px;
    height: 34px;
    background: #14141499;
    border-radius: 5px;
    border-color: #ffffff12;
    border-width: 1px;

    Text { x: 10px; y: 8px; width: 214px; text: root.process.name; color: white; font-size: 11px; overflow: elide; }
    Text { x: 236px; y: 8px; width: 64px; text: root.process.cpu-text; color: root.process.cpu-color; font-size: 10px; horizontal-alignment: right; }
    Text { x: 312px; y: 8px; width: 82px; text: root.process.memory-text; color: root.process.memory-color; font-size: 10px; horizontal-alignment: right; }
    Text { x: 406px; y: 8px; width: 64px; text: root.process.gpu-text; color: root.process.gpu-color; font-size: 10px; horizontal-alignment: right; }
    Rectangle {
        x: 558px; y: 7px; width: 20px; height: 20px;
        background: unpin-area.has-hover ? #f8717133 : #ffffff18;
        border-radius: 4px;
        Text { text: "X"; color: #ffffffd9; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
        unpin-area := TouchArea { mouse-cursor: pointer; clicked => { root.unpin(root.process.pid); } }
    }
}

component ProcessRow inherits Rectangle {
    in property <ProcessData> process;
    in property <int> confirm-pid: -1;
    in property <float> confirm-progress: 0.0;
    callback toggle-pin(int);
    callback kill(int, string);
    width: 564px;
    height: 36px;
    background: row-touch.has-hover ? #ffffff0d : transparent;

    Text { x: 8px; y: 9px; width: 166px; text: root.process.name; color: white; font-size: 11px; overflow: elide; }
    Text { x: 178px; y: 9px; width: 44px; text: root.process.pid; color: #ffffff7f; font-size: 10px; horizontal-alignment: right; }
    Text { x: 230px; y: 9px; width: 50px; text: root.process.cpu-text; color: root.process.cpu-color; font-size: 10px; horizontal-alignment: right; }
    Text { x: 290px; y: 9px; width: 74px; text: root.process.memory-text; color: root.process.memory-color; font-size: 10px; horizontal-alignment: right; }
    Text { x: 374px; y: 9px; width: 48px; text: root.process.gpu-text; color: root.process.gpu-color; font-size: 10px; horizontal-alignment: right; }

    Rectangle {
        x: 438px; y: 8px; width: 30px; height: 20px;
        background: pin-touch.has-hover ? #22d3ee33 : #ffffff14;
        border-radius: 4px;
        Text { text: root.process.pinned ? "ON" : "PIN"; color: root.process.pinned ? #4ade80 : #ffffff9f; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; }
        pin-touch := TouchArea { mouse-cursor: pointer; clicked => { root.toggle-pin(root.process.pid); } }
    }

    Rectangle {
        x: 520px - (root.confirm-pid == root.process.pid ? 2px : 0px);
        y: 8px - (root.confirm-pid == root.process.pid ? 2px : 0px);
        width: root.confirm-pid == root.process.pid ? 24px : 20px;
        height: root.confirm-pid == root.process.pid ? 24px : 20px;
        background: root.confirm-pid == root.process.pid ? #ff9999cc : kill-touch.has-hover ? #ffcccccc : #ffffffcc;
        border-radius: 12px;
        animate x { duration: 150ms; }
        animate y { duration: 150ms; }
        animate width { duration: 150ms; }
        animate height { duration: 150ms; }

        Text { text: "X"; color: #333333; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
        if root.confirm-pid == root.process.pid : Rectangle {
            x: 2px; y: 2px; width: 20px; height: 20px;
            background: transparent;
            border-color: #333333cc;
            border-width: 2px;
            border-radius: 10px;
            opacity: 1.0 - root.confirm-progress;
        }
        kill-touch := TouchArea { mouse-cursor: pointer; clicked => { root.kill(root.process.pid, root.process.name); } }
    }
    row-touch := TouchArea { enabled: false; }
}

export component Shell inherits Window {
    title: "xhm-desktop";
    background: transparent;
    no-frame: true;
    always-on-top: true;
    width: 620px;
    height: root.details-visible ? 520px : min(218px, 96px + root.pinned-area-height);

    in-out property <string> status-text: "winit-software";
    in-out property <bool> connected: false;
    in-out property <bool> details-visible: false;
    in-out property <bool> panel-locked: false;
    in-out property <string> organic-state: "floating";
    in-out property <[MetricData]> metrics;
    in-out property <[ProcessData]> pinned-processes;
    in-out property <[ProcessData]> processes;
    in-out property <[DiskData]> disks;
    in-out property <string> active-metric-id: "";
    in-out property <float> active-metric-scale: 1.0;
    in-out property <int> kill-confirm-pid: -1;
    in-out property <float> kill-confirm-progress: 0.0;
    in-out property <string> toast-message: "";
    in-out property <bool> toast-visible: false;
    out property <float> kill-arc-circumference: 43.98;
    property <int> max-visible-pinned: 3;
    property <length> pinned-area-height: min(root.pinned-processes.length, root.max-visible-pinned) * 40px;

    callback pointer-down(float, float, string);
    callback pointer-move(float, float);
    callback pointer-up(float, float);
    callback pointer-cancel();
    callback hover-changed(bool);
    callback toggle-pin(int);
    callback kill-process(int, string);

    function metric-at(x: length) -> string {
        if x < 110px { return "net"; }
        if x < 204px { return "cpu"; }
        if x < 298px { return "ram"; }
        if x < 392px { return "gpu"; }
        if x < 486px { return "vram"; }
        return "power";
    }

    OrganicShell {
        x: 12px;
        y: 12px;
        width: 596px;
        height: 72px;
        state: root.organic-state;
        floating-background: #0a0a0a99;
    }

    Rectangle {
        x: 12px;
        y: 12px;
        width: 596px;
        height: 72px;
        background: transparent;
        border-color: root.panel-locked ? #4ade80 : #ffffff14;
        border-width: 1px;
        border-radius: 8px;

        HorizontalLayout {
            x: 16px;
            y: 9px;
            width: 564px;
            height: 54px;
            spacing: 6px;
            for metric in root.metrics : MetricCell {
                metric: metric;
                interaction-scale: root.active-metric-id == metric.id ? root.active-metric-scale : 1.0;
            }
        }

        bar-touch := TouchArea {
            mouse-cursor: move;
            changed has-hover => { root.hover-changed(self.has-hover); }
            pointer-event(event) => {
                if event.kind == PointerEventKind.down {
                    root.pointer-down(self.mouse-x / 1px, self.mouse-y / 1px, root.metric-at(self.mouse-x));
                } else if event.kind == PointerEventKind.move && self.pressed {
                    root.pointer-move(self.mouse-x / 1px, self.mouse-y / 1px);
                } else if event.kind == PointerEventKind.up {
                    root.pointer-up(self.mouse-x / 1px, self.mouse-y / 1px);
                } else if event.kind == PointerEventKind.cancel {
                    root.pointer-cancel();
                }
            }
        }

        if !root.connected : Rectangle {
            x: parent.width - 13px; y: 7px; width: 6px; height: 6px;
            background: #f87171;
            border-radius: 3px;
        }
    }

    pinned-list := ListView {
        x: 12px;
        y: 92px;
        width: 596px;
        height: root.pinned-area-height;
        for process in root.pinned-processes : PinnedCard {
            process: process;
            unpin(pid) => { root.toggle-pin(pid); }
        }
    }

    if root.details-visible : Rectangle {
        x: 12px;
        y: 92px + root.pinned-area-height;
        width: 596px;
        height: 408px - root.pinned-area-height;
        background: #141414f0;
        border-radius: 8px;
        border-color: #ffffff14;
        border-width: 1px;
        drop-shadow-color: #00000047;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;

        Text { x: 16px; y: 12px; text: "PROCESSES"; color: #ffffff8f; font-size: 10px; font-weight: 700; }
        Text { x: 448px; y: 12px; width: 124px; text: root.status-text; color: root.connected ? #4ade80 : #f87171; font-size: 9px; horizontal-alignment: right; overflow: elide; }
        Rectangle { x: 16px; y: 34px; width: 564px; height: 1px; background: #ffffff14; }

        process-list := ListView {
            x: 16px;
            y: 42px;
            width: 564px;
            height: max(118px, parent.height - 132px);
            for process in root.processes : ProcessRow {
                process: process;
                confirm-pid: root.kill-confirm-pid;
                confirm-progress: root.kill-confirm-progress;
                toggle-pin(pid) => { root.toggle-pin(pid); }
                kill(pid, name) => { root.kill-process(pid, name); }
            }
        }

        Rectangle {
            x: 16px;
            y: parent.height - 80px;
            width: 564px;
            height: 64px;
            background: #ffffff0a;
            border-radius: 5px;
            Text { x: 8px; y: 7px; text: "DISK I/O"; color: #ffffff8f; font-size: 9px; font-weight: 700; }
            HorizontalLayout {
                x: 76px; y: 4px; width: 480px; height: 56px; spacing: 8px;
                for disk in root.disks : Rectangle {
                    width: 112px;
                    background: transparent;
                    Text { y: 3px; width: parent.width; text: disk.name; color: white; font-size: 10px; overflow: elide; }
                    Text { y: 21px; width: parent.width; text: disk.read-text; color: #22d3ee; font-size: 9px; }
                    Text { y: 37px; width: parent.width; text: disk.write-text; color: #e69f00; font-size: 9px; }
                }
            }
        }
    }

    if root.toast-visible : Rectangle {
        x: 150px;
        y: 20px;
        width: 320px;
        height: 44px;
        background: #000000e6;
        border-radius: 4px;
        border-color: #ffffff24;
        border-width: 1px;
        drop-shadow-color: #00000080;
        drop-shadow-blur: 14px;
        Text {
            x: 12px; y: 8px; width: 296px; height: 28px;
            text: root.toast-message;
            color: white;
            font-size: 11px;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: word-wrap;
        }
    }
}
